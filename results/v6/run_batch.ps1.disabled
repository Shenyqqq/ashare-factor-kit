$ErrorActionPreference = "Continue"
Set-Location "F:\PythonProject\quant_trading"

# UTF-8: Python stdout + PowerShell pipe decode + log file write
chcp 65001 | Out-Null
[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
[Console]::InputEncoding  = [System.Text.UTF8Encoding]::new($false)
$OutputEncoding = [System.Text.UTF8Encoding]::new($false)

$env:LOGURU_COLORIZE     = "0"
$env:PYTHONIOENCODING    = "utf-8"
$env:PYTHONUTF8          = "1"
$env:PYTHONUNBUFFERED    = "1"
$env:DYNAMIC_MAX_WORKERS = "1"

$python = ".\.venv\Scripts\python.exe"
$models = @("xgb", "lgbm", "cat", "dynamic", "ridge", "mlp", "rf")

if (!(Test-Path "results\v6\logs")) {
    New-Item -ItemType Directory -Path "results\v6\logs" -Force | Out-Null
}

foreach ($mode in $models) {
    $logPath = "results\v6\logs\run_${mode}_h5.log"
    if (Test-Path $logPath) { Remove-Item $logPath -Force }
    Write-Host "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] Starting mode=$mode -> $logPath"
    & $python -u run.py --skip-download --mode $mode --horizon 5 --factor-config config/factor_configs.yaml --output-dir results/v6 2>&1 |
        ForEach-Object {
            $_ | Out-File -FilePath $logPath -Append -Encoding utf8
            $_
        }
    if ($LASTEXITCODE -ne 0) {
        Write-Host "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] FAILED mode=$mode exit=$LASTEXITCODE"
    } else {
        Write-Host "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] OK mode=$mode"
    }
}
Write-Host "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] Batch complete."
