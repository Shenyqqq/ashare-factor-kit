# Poll v6 h5 batch (7 ML modes) until complete, then launch v7 h20 batch.
# Does NOT kill or interfere with running v6 jobs.
$ErrorActionPreference = "Continue"
$root = "F:\PythonProject\quant_trading"
Set-Location $root

chcp 65001 | Out-Null
[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
$OutputEncoding = [System.Text.UTF8Encoding]::new($false)

$v6Out = Join-Path $root "results\v6"
$v7Script = Join-Path $root "results\v7\run_v7_h20_batch.ps1"
$monitorLog = Join-Path $v6Out "logs\monitor_and_launch_v7.log"
New-Item -ItemType Directory -Force -Path (Join-Path $v6Out "logs") | Out-Null

$v6Modes = @("ridge", "lgbm", "xgb", "cat", "rf", "mlp", "dynamic")
$pollSec = 300

function Test-V6ModeDone([string]$mode) {
    $tag = "${mode}_h5"
    $backtest = Join-Path $v6Out "backtest_${tag}.png"
    if ($mode -eq "dynamic") {
        $scores = Join-Path $v6Out "factor_scores_${tag}.parquet"
        return (Test-Path $backtest) -and (Test-Path $scores)
    }
    $metrics = Join-Path $v6Out "model_metrics_${tag}.json"
    return (Test-Path $metrics) -and (Test-Path $backtest)
}

function Get-V6Status {
    $done = @(); $pending = @()
    foreach ($m in $v6Modes) {
        if (Test-V6ModeDone $m) { $done += $m } else { $pending += $m }
    }
    [PSCustomObject]@{ Done = $done; Pending = $pending; Complete = ($pending.Count -eq 0) }
}

function Test-V6RunPyActive {
    Get-CimInstance Win32_Process -Filter "Name='python.exe'" -ErrorAction SilentlyContinue |
        Where-Object { ($_.CommandLine -match 'run\.py') -and ($_.CommandLine -match 'results\\v6') }
}

function Test-V7AlreadyRunning {
    Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" -ErrorAction SilentlyContinue |
        Where-Object { $_.CommandLine -match 'run_v7_h20_batch\.ps1' }
}

"=== monitor_and_launch_v7 START $(Get-Date -Format o) ===" | Tee-Object -FilePath $monitorLog -Append

while ($true) {
    $st = Get-V6Status
    $active = @(Test-V6RunPyActive)
    $line = "$(Get-Date -Format o) v6 done=[$($st.Done -join ',')] pending=[$($st.Pending -join ',')] python_v6=$($active.Count)"
    $line | Tee-Object -FilePath $monitorLog -Append

    if ($st.Complete) {
        "v6 complete - launching v7" | Tee-Object -FilePath $monitorLog -Append
        break
    }
    Start-Sleep -Seconds $pollSec
}

if (-not (Test-Path $v7Script)) {
    "ERROR: missing $v7Script" | Tee-Object -FilePath $monitorLog -Append
    exit 1
}

if (Test-V7AlreadyRunning) {
    "v7 batch already running - skip duplicate launch" | Tee-Object -FilePath $monitorLog -Append
    exit 0
}

$v7Log = Join-Path $root "results\v7\logs\batch_wrapper.log"
New-Item -ItemType Directory -Force -Path (Join-Path $root "results\v7\logs") | Out-Null
Start-Process powershell.exe -ArgumentList @(
    "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", $v7Script
) -WorkingDirectory $root -RedirectStandardOutput $v7Log -RedirectStandardError ($v7Log + ".err") -WindowStyle Hidden

"=== v7 launched $(Get-Date -Format o) log=$v7Log ===" | Tee-Object -FilePath $monitorLog -Append
